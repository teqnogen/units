{
    "name": "teqnogen/units",
    "description": "Laravel package for unit conversion with predefined unit types and units",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Teqnogen",
            "email": "teqnogen@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Teqnogen\\Units\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teqnogen\\Units\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teqnogen\\Units\\UnitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 900,
        "preferred-install": {
            "*": "dist"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "unit-conversion",
        "units",
        "conversion"
    ],
    "homepage": "https://github.com/teqnogen/units",
    "support": {
        "issues": "https://github.com/teqnogen/units/issues",
        "source": "https://github.com/teqnogen/units"
    }
}